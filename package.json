{
  "name": "@nuvin/computer-use",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Drive the macOS desktop from a CLI — accessibility-tree actions (snapshot → press/set-value) and pixel actions (screenshot → click/move/drag). Foreground automation for agents.",
  "keywords": [
    "macos",
    "automation",
    "computer-use",
    "accessibility",
    "screenshot",
    "agent",
    "desktop-automation",
    "ui-automation",
    "cgevent",
    "screencapturekit"
  ],
  "license": "MIT",
  "author": "Marsch Huynh <marsch.huynh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marschhuynh/nuvin-computer-use.git"
  },
  "bin": {
    "nuvin-computer-use": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "os": ["darwin"],
  "files": [
    "dist/",
    "docs/cli.md",
    "docs/agent-guide.md",
    "docs/permissions.md",
    "docs/testing.md",
    "docs/changeset-computer-use-tool.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:ts": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/make-executable.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run build:ts && npm run build:native",
    "prepack": "npm run build",
    "native-tests": "node scripts/native-tests.mjs",
    "test:build-hygiene": "node scripts/test-build-hygiene.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/native-protocol.test.ts --exclude '**/.worktrees/**'",
    "test:native-protocol": "node scripts/native-protocol-tests.mjs",
    "ax-helper": "make ax-helper"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
