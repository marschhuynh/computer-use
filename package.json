{
  "name": "nuvin-computer-use",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone restoration of the ComputerUseTool from marschhuynh/nuvin-cli (macOS accessibility-tree + screenshot automation)",
  "bin": {
    "nuvin-computer-use": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "os": ["darwin"],
  "files": ["dist/", "native/", "docs/"],
  "scripts": {
    "build:ts": "tsc -p tsconfig.build.json",
    "build:native": "node scripts/build-native.mjs",
    "build": "npm run build:ts && npm run build:native",
    "native-tests": "node scripts/native-tests.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ax-helper": "make ax-helper"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
